+def _owner_read_only_allowlist(config: dict) -> frozenset[str]:
+    """Only exact MCP tool names from local config can bypass approval.
+
+    Missing, malformed, globbed or duplicated entries fail closed. This does
+    not consult MCP tool annotations or any server-delivered text.
+    """
+    values = (config or {}).get("read_only_allowlist", [])
+    if type(values) is not list or len(values) > 128 or any(
+        type(name) is not str or re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}", name) is None
+        for name in values
+    ) or len(set(values)) != len(values):
+        logger.warning("MCP owner read-only allowlist invalid; ignoring entire list")
+        return frozenset()
+    return frozenset(values)
+
