+def _tool_is_read_only(server_name: str, tool_name: str) -> bool:
+    """Effective permission AND retry policy, never remote annotation alone.
+
+    On untrusted servers a positive server hint must be independently vetted
+    by the operator's exact per-tool read-only allowlist. Missing policy
+    metadata is untrusted. Shared connections use the consuming profile's
+    own allowlist, not the original connection owner's privileges.
+    """
+    from tools.mcp_tool_scope import _resolve_server_key, _server_key
+    hint = _core._tool_read_only_hints.get(_resolve_server_key(server_name), {}).get(tool_name) is True
+    if not hint:
+        return False
+    policy_key = _server_key(server_name)
+    trust = _core._server_trust_levels.get(policy_key, _core._TRUST_UNTRUSTED)
+    if trust == _core._TRUST_FULL:
+        return True
+    return tool_name in _core._owner_read_only_allowlists.get(policy_key, frozenset())
