[Unit]
Description=Hermes H-24 read-only Google Search Console snapshot
Documentation=https://github.com/MikeMoore1337/hermes/issues/191
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes-gsc
Group=hermes-gsc
WorkingDirectory=/opt/hermes-agent-owner
ExecStart=/opt/hermes-gsc/venv/bin/python -m scripts.hermes_gsc_collect --credentials /etc/hermes-gsc/service-account.json --output /var/lib/hermes-gsc/latest.json
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=192M
TasksMax=20
RuntimeMaxSec=100
ReadOnlyPaths=/etc/hermes-gsc
ReadWritePaths=/var/lib/hermes-gsc
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# Pre-activation: absolutely no outbound network. PrivateNetwork and the AF_UNIX
# restriction are independent fail-closed layers; IPAddressDeny is complementary.
# Before a separately approved Google OAuth smoke, implement and verify a
# *different* narrowly scoped Google-only OS egress policy (no DNS-only claim).
IPAddressDeny=any
# IMPORTANT: installing this dormant unit is NOT runtime activation, OAuth
# permission, or authorization to enable its timer.

[Install]
WantedBy=multi-user.target
