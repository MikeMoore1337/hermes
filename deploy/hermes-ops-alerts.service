[Unit]
Description=Hermes Ops Watch: send one queued owner-only Telegram alert
Documentation=https://github.com/MikeMoore1337/hermes/issues/3
Wants=network-online.target
After=network-online.target local-fs.target
RequiresMountsFor=/var/lib/hermes-agent/ops-watch /etc/hermes-agent
AssertPathExists=/var/lib/hermes-agent/ops-watch/incidents.sqlite3
AssertPathExists=/etc/hermes-agent/ops-watch.env
# Ten-minute timer consumes about 6 starts/hour. Keep a bounded reserve
# for owner diagnostics and short scheduling jitter without throttling normal
# idle polls: 12 starts/hour still protects against manual invocation storms.
# This is a start-count limit, NOT a send retry policy. One start still sends
# at most one existing outbox event, through the existing receipt lease.
StartLimitIntervalSec=1h
StartLimitBurst=12

[Service]
Type=oneshot
User=root
Group=root
RuntimeDirectory=hermes-ops-alerts
RuntimeDirectoryMode=0700
BindPaths=/var/lib/hermes-agent/ops-watch:/run/hermes-ops-alerts/outbox
WorkingDirectory=/opt/hermes-agent-owner
ExecStart=/usr/bin/python3 -m ops_watch.telegram_dispatch --execute
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
UMask=0077
ReadWritePaths=/run/hermes-ops-alerts/outbox
ReadOnlyPaths=/etc/hermes-agent/ops-watch.env
InaccessiblePaths=/var/lib/hermes /var/lib/hermes-agent /etc/hermes-agent/github-actions-read.token /etc/hermes-agent/research-scout.env
MemoryMax=96M
CPUQuota=10%
TasksMax=20
TimeoutStartSec=35s
StandardOutput=journal
StandardError=journal
