[Unit]
Description=Hermes H-01 Ops AI analysis when verified incidents need context
Documentation=https://github.com/MikeMoore1337/hermes/issues/33

[Timer]
# One periodic trigger: OnActiveSec in combination with OnUnitInactiveSec
# caused 13-minute double starts and StartLimitBurst=2 rejection in production.
# Keep this exact cadence aligned with the owner-applied 2026-10-19 fix.
OnUnitInactiveSec=35min
RandomizedDelaySec=3min
Persistent=false
Unit=hermes-h01-ops-agent.service

[Install]
WantedBy=timers.target
