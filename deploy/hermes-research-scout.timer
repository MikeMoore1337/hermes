[Unit]
Description=Hermes Research Scout: independent daily public metadata search

[Timer]
# Exactly one calendar slot per day. Do not add an OnActiveSec boot/restart
# trigger: initial review is performed explicitly by the installer.
OnCalendar=*-*-* 19:30:00
RandomizedDelaySec=5min
AccuracySec=1min
Persistent=false
Unit=hermes-research-scout.service

[Install]
WantedBy=timers.target
