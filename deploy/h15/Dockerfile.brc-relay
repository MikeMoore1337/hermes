# H-15 #371 disposable CI: build the REAL MIT BRC relay and shared packages
# from the exact approved, already policy-patched upstream checkout.
# Eval-only base is pinned to an immutable OCI manifest digest proven by CI.
# Do NOT publish/deploy this image without approved device/shell scope.
FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS builder
WORKDIR /opt/brc
RUN npm install --global pnpm@11.24.0
COPY . .
RUN pnpm install --frozen-lockfile && pnpm build

FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS runtime
LABEL org.opencontainers.image.title="Hermes Self-hosted Remote MCP Relay (evaluation only)" \
      org.opencontainers.image.description="Hardened, source-audited BRC prototype. Owner commands disabled pending per-device approval." \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/MikeMoore1337/hermes" \
      org.opencontainers.image.revision="cbe511702dd0147650353c29ac6ab1decd8afda1"
WORKDIR /opt/brc
COPY --from=builder --chown=65534:65534 /opt/brc /opt/brc
# Production relay only needs node, not npm/npx CLIs or npm's bundled
# dependency tree (including its vulnerable undici). Leave builder unchanged.
RUN rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx \
    && test -x /usr/local/bin/node \
    && test ! -e /usr/local/lib/node_modules/npm

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=127.0.0.1 \
    PUBLIC_URL=http://127.0.0.1:3000 \
    BRC_DB=/state/relay.sqlite \
    TRUST_PROXY=false \
    HOME=/tmp
USER 65534:65534
EXPOSE 3000
CMD ["node", "packages/relay/dist/cli.js"]
