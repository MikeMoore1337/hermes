# A verified local base tag, pinned compiled files and a public CA are required.
# The operator must verify the tag's immutable ID and inherited layers.
ARG H454_BASE_IMAGE
FROM ${H454_BASE_IMAGE}
USER 0:0
RUN mkdir -m 0755 /opt/hermes-brc
COPY --chown=0:0 --chmod=0444 cli.js cli.js.map /app/dist/
RUN echo '348866e527fe862ce15aeaf82c217de158e880fcf8df5d219339027488462252  /app/dist/cli.js' | sha256sum --check --status \
    && echo '7ee049973509eaed4a2e6aac57204e43b946a87bec4f8824b4e5ff6af07b8328  /app/dist/cli.js.map' | sha256sum --check --status
COPY --chown=0:0 --chmod=0444 ws-client.js ws-client.js.map /app/dist/transport/
COPY --chown=0:0 --chmod=0444 relay-ca.pem /opt/hermes-brc/relay-ca.pem
USER 65534:65534
